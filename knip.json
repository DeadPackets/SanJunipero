{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "*.ts",
        "*.js"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/forge": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/*.ts",
        "!scripts/{scratch,character,cast,cast-v5}.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/engine": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/llm": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/live": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/town": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/web": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "rules": {
    "duplicates": "warn"
  }
}
