{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "*.ts",
        "*.js"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/forge": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/build-farmland.ts",
        "scripts/gen-cast-v4.ts",
        "scripts/gen-cast-v5.ts",
        "scripts/gen-character-v4.ts",
        "scripts/gen-dwellings-v2.ts",
        "scripts/gen-dwellings.ts",
        "scripts/gen-library-v2.ts",
        "scripts/gen-library.ts",
        "scripts/gen-structures-v5.ts",
        "scripts/gen-terrain-textures.ts",
        "scripts/recell-buildings.ts",
        "scripts/recell-characters.ts",
        "scripts/repair-sleep-cell.ts",
        "scripts/requantize-portraits.ts",
        "scripts/write-autotile-set.ts",
        "scripts/write-generated-terrain.ts",
        "scripts/write-terrain-tileset.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/engine": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/web": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "rules": {
    "duplicates": "warn"
  }
}
